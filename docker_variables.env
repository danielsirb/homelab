# General Variables
FAST_STORAGE=/home
SLOW_STORAGE=/2Tb-raid/data
MOVIE_STORAGE=/Volume1
SERIES_STORAGE=/Volume2
DOCKER_DATA_DIR=docker-containers
LOG_FILE=/var/log/auto_docker_containers.log
#Fast & Slow data dirs
DOCKER_FAST_DATA=$FAST_STORAGE/$DOCKER_DATA_DIR
DOCKER_SLOW_DATA=$SLOW_STORAGE/$DOCKER_DATA_DIR

#Docker compose Files
DOCKER_COMPOSE_DIR=$FAST_STORAGE/docker-compose

SCRIPT_LIB=/home/lib.sh
TIME_ZONE="Europe/Bucharest"
MEDIA_PUID=1000
MEDIA_PGID=1000
